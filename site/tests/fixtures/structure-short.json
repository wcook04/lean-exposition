    "selected": true,
    "treatments": [
     {
      "claim_id": "scalar.smooth_positive_density",
      "kinds": [
       "derivation"
      ],
      "rationale": "Develops smoothness from the quotient of moments before differentiating, then transfers the quantitative spatial-moment inequality through local constant replacements at a fixed interior time. Compact-strip stability is a cited input; positivity is asserted only for 0<t<1, and the argument does not transfer third time derivatives or add formal acceptance."
     },
     {
      "claim_id": "support.fixed_time_spatial_coercivity",
      "kinds": [
       "derivation",
       "explanation"
      ],
      "rationale": "Derives the continuous-coefficient fixed-time inequality by admissible local constant replacement and common-strip convergence of spatial moments, then applies it after q=t. Minimality is unnecessary for the transfer itself."
     }
    ]
   },
