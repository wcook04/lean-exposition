    "selected": true,
    "treatments": [
     {
      "claim_id": "qaoa_thermodynamic_first",
      "kinds": [
       "statement",
       "explanation"
      ],
      "rationale": "States the accuracy-dependent finite deterministic depth and angles before the size limit, and outlines the additional synthesis, seed-removal and fixed-word transfer steps. The passage routes the complete construction elsewhere and gives no depth rate or efficient angle-selection guarantee. A separate word-dependent expected-energy estimate is available, but without bounds on the chosen depth and cost angles it supplies no size threshold in optimization accuracy alone and no measurement-concentration rate."
     },
     {
      "claim_id": "scalar.shifted_gaussian_limit",
      "kinds": [
       "statement",
       "explanation"
      ],
      "rationale": "States the finite adjacent-correlation limit and explains normalization, mean-preserving rounding, l2 error control and the mesh-before-cutoff order; full estimates remain in the long record."
     },
     {
      "claim_id": "circuit.rooted_realization",
      "kinds": [
       "explanation"
      ],
      "rationale": "Explains the first-chaos coefficient of the parent coordinate and its pairing with the generating child direction, including the zero independent-root-seed contribution. The source theorem supplies the full rooted construction."
     }
    ]
   },
