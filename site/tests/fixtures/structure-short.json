    "treatments": [
     {
      "claim_id": "support.contact",
      "kinds": [
       "derivation"
      ],
      "rationale": "Derives nonnegative tail cost and its vanishing on the support by feasible atom addition and compact fractional mass removal. The first-variation formula and regularity are cited inputs, and the sign conclusion uses minimality."
     },
     {
      "claim_id": "support.contact_derivatives",
      "kinds": [
       "derivation"
      ],
      "rationale": "Derives the value and slope conditions from derivatives of the contact function, with a separate right-hand expansion at zero. The origin argument retains contact at zero when zero belongs to the support and the zero-field identity q(0)=0."
     }
    ]
   },
