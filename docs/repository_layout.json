{
  "schema_version": "1.0",
  "root_files": {
    ".editorconfig": "Editor conventions",
    ".gitattributes": "Git text and distribution conventions",
    ".gitignore": "Unmaintained local output exclusions",
    ".python-version": "Optional Python version selection",
    "AGENTS.md": "Contributor entry instructions",
    "CHANGELOG.md": "Release notes",
    "CITATION.cff": "Software citation metadata",
    "CONTRIBUTING.md": "Contribution instructions",
    "LICENSE": "Repository license",
    "Makefile": "Optional developer command entry",
    "NOTICE": "Copyright and attribution notices",
    "README.md": "User entry, runnable example and repository map",
    "SECURITY.md": "Security reporting instructions",
    "pyproject.toml": "Python package and command interface",
    "uv.lock": "Optional dependency lock"
  },
  "directory_roles": {
    ".github": "Hosted checks and repository automation",
    "docs": "Authored documentation, contracts, reference records and selected licensed research readings",
    "examples": "Runnable examples, licensed source snapshots and fixtures",
    "lean": "Lean integration documentation",
    "papers": "Source-grounded mathematical manuscripts and their citation records",
    "scripts": "Repository maintenance commands",
    "skills": "Optional authoring instructions independent of runtime",
    "src": "Installable Python runtime and packaged resources",
    "tests": "Executable regression tests"
  },
  "required_paths": [
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "pyproject.toml",
    "docs/authoring.md",
    "docs/contracts.md",
    "docs/repository_layout.json",
    "examples/minimal/Minimal.lean",
    "lean/README.md",
    "papers/README.md",
    "scripts/check_layout.py",
    "skills/README.md",
    "skills/source-to-graph/SKILL.md",
    "skills/graph-to-long/SKILL.md",
    "skills/long-to-short/SKILL.md",
    "skills/record-to-expository/SKILL.md",
    "src/lean_exposition/__init__.py",
    "src/lean_exposition/cli.py",
    "src/lean_exposition/resources/lean/Extract.lean",
    "src/lean_exposition/resources/schemas/graph.schema.json",
    "src/lean_exposition/resources/schemas/artifact.schema.json",
    "src/lean_exposition/resources/schemas/bundle.schema.json",
    "src/lean_exposition/resources/templates/long.md",
    "src/lean_exposition/resources/templates/short.md",
    "src/lean_exposition/resources/templates/expository.md",
    "tests/test_layout.py"
  ],
  "readme_map": [
    ".github/",
    "docs/",
    "examples/",
    "lean/",
    "papers/",
    "scripts/",
    "skills/",
    "src/lean_exposition/",
    "tests/"
  ],
  "entry_references": [
    "README.md",
    "docs/contracts.md",
    "scripts/check_layout.py"
  ]
}
